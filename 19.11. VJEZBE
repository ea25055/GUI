import javax.swing.JOptionPane;

public class PrviProgram {

	public static void main(String[] args) {
		
		String ime = javax.swing.JOptionPane.showInputDialog(null, "Unesite"
				+ " " + "ime: ");
		String prezime = javax.swing.JOptionPane.showInputDialog(null, "Unesite"
				+ " " + "prezime: ");
		String godiste = javax.swing.JOptionPane.showInputDialog(null, "Unesite"
				+  " " + "godiste: ");
		
		int godisteInt = Integer.parseInt(godiste);
		
		String format = String.format("Pregled Podataka:\n "
				+ "Ime: %s \n Prezime: %s \n Godiste rodjenja:  %d:"
